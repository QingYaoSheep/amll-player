    "error.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify Error"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 错误"}}}},
    "error.offline" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The network is unavailable. Playback will resynchronize when you are online."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网络不可用，恢复联网后将重新同步播放状态。"}}}},
    "error.spotifyAppRemoteUnavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify App Remote is unavailable. Using Spotify Connect instead."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify App Remote 不可用，已改用 Spotify Connect。"}}}},
    "error.spotifyConfigurationMissing" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify Client ID is not configured."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未配置 Spotify Client ID。"}}}},
    "error.spotifyInvalidResponse" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify returned an unexpected response."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 返回了无法识别的响应。"}}}},
    "error.spotifyNoActiveDevice" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No active Spotify device. Open Spotify on a device or choose a Connect device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有活跃的 Spotify 设备。请在某台设备上打开 Spotify，或选择 Connect 设备。"}}}},
    "error.spotifyNoPlayback" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nothing is currently playing in Spotify."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 当前没有播放内容。"}}}},
    "error.spotifyNotAuthorized" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect your Spotify account first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先连接 Spotify 账户。"}}}},
    "error.spotifyPremiumRequired" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This playback command requires Spotify Premium."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该播放操作需要 Spotify Premium。"}}}},
    "error.spotifyRateLimited" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify is temporarily rate limiting requests. Try again shortly."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 暂时限制了请求频率，请稍后重试。"}}}},
    "error.spotifyRestrictedDevice" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected Spotify device does not allow this control."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选 Spotify 设备不允许执行该控制。"}}}},
    "error.spotifyRedirectInvalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The app's Spotify callback URI is invalid. Please install a corrected build; re-entering the Client ID will not fix this."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用内的 Spotify 回调地址配置无效，请安装修复后的版本；重新输入 Client ID 无法解决此问题。"}}}},
    "error.spotifyTokenExpired" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Spotify session expired. Connect the account again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 会话已失效，请重新连接账户。"}}}},
    "error.spotifyTransport" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify could not complete the request."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 无法完成请求。"}}}},
