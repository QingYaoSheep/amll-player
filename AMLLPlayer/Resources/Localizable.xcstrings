    "lyrics.cache.clear.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes cached raw and parsed lyrics. Keeps manual choices, timing offsets and credentials; the currently displayed lyrics remain until replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除缓存里的歌词原文和解析结果。保留手动选择的歌词、延迟和凭据。当前显示的歌词会保留到被替换。"
          }
        }
      }
    },
