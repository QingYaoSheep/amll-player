    "render.resumeMarquee" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Double-tap to resume scrolling"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"轻点两下恢复滚动"}}}},
