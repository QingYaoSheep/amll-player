    "catalog.unknown" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unknown title"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未知名称"}}}},
    "catalog.openSpotify" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open in Spotify"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Spotify 中打开"}}}},
    "catalog.unsupported" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only Spotify music is supported"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅支持 Spotify 音乐内容"}}}},
    "catalog.restricted" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unavailable for this account or region"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前账号或地区不可播放"}}}},
    "catalog.metadataOnly" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify has not made these tracks available to this app. Open in Spotify to continue."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 未向本应用开放这些曲目，请在 Spotify 中打开。"}}}},
    "catalog.error.signIn" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your Spotify session is unavailable. Sign out and sign in again in Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 会话不可用，请在设置中退出并重新登录。"}}}},
    "catalog.error.forbidden" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify denied access. Check the app's user access list and sign in again to grant library permissions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 拒绝访问。请检查应用用户访问列表，并重新登录以授予音乐库读取权限。"}}}},
    "catalog.error.unavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This content is no longer available to this app."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本应用暂时无法访问此内容。"}}}},
    "catalog.error.quota" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify's app quota is exhausted. Automatic retries have stopped. Check the developer dashboard before reconnecting."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 应用配额已耗尽，已停止自动重试。请检查开发者控制台后再重新连接。"}}}},
    "catalog.error.rateLimit" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify is limiting requests. Retry after:"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 正在限制请求频率，请在此时间后重试："}}}},
    "settings.login" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Login"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"登录"}}}},
    "settings.login.spotify" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sign in to Spotify"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"登录到Spotify"}}}},
    "settings.login.authorize" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Authorize and sign in"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"授权登录"}}}},
    "settings.login.saveHelp" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your Client ID is saved on this device when you tap Authorize. Changing it disconnects the current account and requires a new sign-in."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点“授权登录”会把 Client ID 保存到本机。更换 ID 后，当前账号会断开，需要用新配置重新授权。"}}}},
    "settings.login.apiHelp" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify API setup:\n1. Open the Spotify Developer Dashboard and create an app. Select Web API and iOS where available.\n2. In the app settings, add and save this exact Redirect URI:"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify API 配置方法：\n1. 打开 Spotify Developer Dashboard，创建应用，并在适用的选项中勾选 Web API 和 iOS。\n2. 在应用设置的 Redirect URIs 中添加并保存以下地址，须完全一致："}}}},
    "settings.login.bundleHelp" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"For the iOS integration, enter this app's Bundle ID (use the actual value after re-signing):"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置 iOS 集成时填写本应用的 Bundle ID（重新签名后以实际值为准）："}}}},
    "settings.login.finishHelp" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"3. Copy the Client ID into the field above, then tap Authorize and sign in.\n4. In Development Mode, add the Spotify account you will use to the app's user access list if required. Playback controls may require Spotify Premium.\nNo Client Secret is needed: sign-in uses PKCE and the system browser."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"3. 将 Client ID 复制到上方输入框，再点击“授权登录”。\n4. Development Mode 下，如有要求，请在应用的用户访问列表中添加要登录的 Spotify 账户。播放控制可能需要 Spotify Premium。\n登录使用 PKCE 和系统网页授权，无需填写 Client Secret。"}}}},
    "settings.login.dashboard" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Spotify Developer Dashboard"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开 Spotify 开发者控制台"}}}},
    "settings.login.documentation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify API setup documentation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify API 官方配置说明"}}}},
    "app.name" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AMLL Player"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AMLL Player"}}}},
    "common.done" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Done"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"完成"}}}},
    "common.ok" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OK"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好"}}}},
    "error.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify Error"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 错误"}}}},
    "error.offline" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The network is unavailable. Playback will resynchronize when you are online."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前没有网络。恢复联网后会重新同步播放状态。"}}}},
    "error.spotifyAppRemoteUnavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify App Remote is unavailable. Using Spotify Connect instead."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify App Remote 不可用，已改用 Spotify Connect。"}}}},
    "error.spotifyConfigurationMissing" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify Client ID is not configured."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未配置 Spotify Client ID。"}}}},
    "error.spotifyInvalidResponse" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify returned an unexpected response."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 返回了无法识别的响应。"}}}},
    "error.spotifyNoActiveDevice" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No active Spotify device. Open Spotify on a device or choose a Connect device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有活跃的 Spotify 设备。请在某台设备上打开 Spotify，或选择 Connect 设备。"}}}},
    "error.spotifyNoPlayback" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nothing is currently playing in Spotify."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 当前没有播放内容。"}}}},
    "error.spotifyNotAuthorized" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect your Spotify account first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先连接 Spotify 账户。"}}}},
    "error.spotifyPremiumRequired" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This playback command requires Spotify Premium."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该播放操作需要 Spotify Premium。"}}}},
    "error.spotifyRateLimited" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify is temporarily rate limiting requests. Try again shortly."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 暂时限制了请求频率，请稍后重试。"}}}},
    "error.spotifyRestrictedDevice" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected Spotify device does not allow this control."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选 Spotify 设备不允许执行该控制。"}}}},
    "error.spotifyRedirectInvalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The app's Spotify callback URI is invalid. Please install a corrected build; re-entering the Client ID will not fix this."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此版本的 Spotify 回调地址有误。请安装修复后的版本，重新填写 Client ID 无法解决。"}}}},
    "error.spotifyTokenExpired" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Spotify session expired. Connect the account again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 会话已失效，请重新连接账户。"}}}},
    "error.spotifyTransport" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify could not complete the request."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 无法完成请求。"}}}},
