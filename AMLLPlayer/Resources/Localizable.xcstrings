    "foundation.spotifySDK" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify iOS SDK 5.0.1"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify iOS SDK 5.0.1"}}}},
