    "lyrics.apple.catalogOK" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Public Catalog check passed; lyric access has not been verified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"公共 Catalog 验证通过；不代表已取得歌词权限。"}}}},
    "lyrics.apple.accountOK" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Account check passed; lyric access is checked per song and region."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账号验证通过；歌词权限仍需按歌曲和地区验证。"}}}},
    "lyrics.apple.expires" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cached automatic bearer expires:"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动 bearer 到期："}}}},
    "lyrics.apple.noAutomatic" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No valid automatic bearer cached; it will be discovered on demand."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚无有效自动 bearer 缓存，将按需获取。"}}}},
    "lyrics.credential.saved" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credential saved in Keychain"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"凭据已保存到 Keychain"}}}},
    "lyrics.credential.empty" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not configured"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未配置"}}}},
    "lyrics.credential.saveMedia" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save media-user-token"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存 media-user-token"}}}},
    "lyrics.credential.deleteMedia" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete media-user-token"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除 media-user-token"}}}},
    "lyrics.credential.saveManual" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save manual bearer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存手动 bearer"}}}},
    "lyrics.credential.deleteManual" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete manual bearer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除手动 bearer"}}}},
    "lyrics.credential.deleteAll" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete all Apple lyric credentials"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除全部 Apple 歌词凭据"}}}},
    "lyrics.credential.delete.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletes the selected Keychain credential only. Spotify login, cached lyrics and manual matches are not deleted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅删除所选 Keychain 凭据；不删除 Spotify 登录、歌词缓存和人工匹配。"}}}},
    "lyrics.error.notFound" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No synchronized lyrics found."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有找到同步歌词。"}}}},
    "lyrics.error.malformed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Invalid or unsupported lyric data."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"歌词数据损坏或格式不受支持。"}}}},
    "lyrics.error.tooLarge" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The lyric response exceeded safety limits."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"歌词响应超过安全限制。"}}}},
    "lyrics.error.transport" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Network request failed. Existing lyrics are retained."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网络请求失败，已有歌词会保留。"}}}},
    "lyrics.error.credentials" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Configure or renew your Apple Music media-user-token."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请配置或更新 Apple Music media-user-token。"}}}},
    "lyrics.error.bearer" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Public Catalog bearer unavailable, invalid or expired."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"公共 Catalog bearer 获取失败、无效或已过期。"}}}},
    "lyrics.error.account" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Apple Music account credential was rejected."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple Music 账号凭据验证失败。"}}}},
    "lyrics.error.permission" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Music lyric access denied; check storefront, subscription and lyric permissions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple Music 歌词访问被拒绝，请检查地区、订阅和歌词权限。"}}}},
    "lyrics.error.cache" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cache could not be read or saved. Current lyrics remain usable; changes may not survive a restart."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缓存读取或保存失败。当前歌词仍可使用，但修改可能无法在重启后保留。"}}}},
