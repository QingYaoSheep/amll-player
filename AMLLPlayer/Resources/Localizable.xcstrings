    "catalog.unsupported" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only Spotify music is supported"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅支持 Spotify 音乐内容"}}}},
    "catalog.restricted" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unavailable for this account or region"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前账号或地区不可播放"}}}},
    "catalog.metadataOnly" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify has not made these tracks available to this app. Open in Spotify to continue."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 未向本应用开放这些曲目，请在 Spotify 中打开。"}}}},
    "catalog.error.signIn" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your Spotify session is unavailable. Sign out and sign in again in Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 会话不可用，请在设置中退出并重新登录。"}}}},
    "catalog.error.forbidden" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify denied access. Check the app's user access list and sign in again to grant library permissions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 拒绝访问。请检查应用用户访问列表，并重新登录以授予音乐库读取权限。"}}}},
    "catalog.error.unavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This content is no longer available to this app."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本应用暂时无法访问此内容。"}}}},
    "catalog.error.quota" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify's app quota is exhausted. Automatic retries have stopped. Check the developer dashboard before reconnecting."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 应用配额已耗尽，已停止自动重试。请检查开发者控制台后再重新连接。"}}}},
    "catalog.error.rateLimit" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify is limiting requests. Retry after:"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify 正在限制请求频率，请在此时间后重试："}}}},
    "settings.login" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Login"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"登录"}}}},
    "settings.login.spotify" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sign in to Spotify"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"登录到Spotify"}}}},
    "settings.login.authorize" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Authorize and sign in"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"授权登录"}}}},
    "settings.login.saveHelp" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your Client ID is saved on this device when you tap Authorize. Changing it disconnects the current account and requires a new sign-in."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点击“授权登录”会在本机保存 Client ID；更换 ID 会断开当前账户，并使用新配置重新授权。"}}}},
    "settings.login.apiHelp" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify API setup:\n1. Open the Spotify Developer Dashboard and create an app. Select Web API and iOS where available.\n2. In the app settings, add and save this exact Redirect URI:"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify API 配置方法：\n1. 打开 Spotify Developer Dashboard，创建应用，并在适用的选项中勾选 Web API 和 iOS。\n2. 在应用设置的 Redirect URIs 中添加并保存以下地址，须完全一致："}}}},
    "settings.login.bundleHelp" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"For the iOS integration, enter this app's Bundle ID (use the actual value after re-signing):"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置 iOS 集成时填写本应用的 Bundle ID（重新签名后以实际值为准）："}}}},
    "settings.login.finishHelp" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"3. Copy the Client ID into the field above, then tap Authorize and sign in.\n4. In Development Mode, add the Spotify account you will use to the app's user access list if required. Playback controls may require Spotify Premium.\nNo Client Secret is needed: sign-in uses PKCE and the system browser."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"3. 将 Client ID 复制到上方输入框，再点击“授权登录”。\n4. Development Mode 下，如有要求，请在应用的用户访问列表中添加要登录的 Spotify 账户。播放控制可能需要 Spotify Premium。\n无需填写 Client Secret；登录使用 PKCE 和系统网页授权。"}}}},
    "settings.login.dashboard" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Spotify Developer Dashboard"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开 Spotify 开发者控制台"}}}},
    "settings.login.documentation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify API setup documentation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify API 官方配置说明"}}}},
