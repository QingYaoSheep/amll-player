    "catalog.searchPrompt" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Songs, albums, artists and playlists"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索歌曲、专辑、艺人和歌单"}}}},
