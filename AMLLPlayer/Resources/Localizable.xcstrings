    "settings.clientSecretHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not enter a Client Secret in an iPhone app. Native apps cannot keep it secret, so AMLL uses Spotify's PKCE flow and stores only the resulting token in Keychain. A Client Secret belongs on a trusted server only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿在 iPhone 应用中输入 Client Secret。原生应用无法安全保密它，因此 AMLL 使用 Spotify 的 PKCE 流程，只在钥匙串中保存授权令牌。Client Secret 只能放在可信服务器上。"
          }
        }
      }
    },
