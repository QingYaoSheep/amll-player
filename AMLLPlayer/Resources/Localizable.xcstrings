    "lyrics.preview.loading" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Loading preview…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在加载预览…"}}}},
    "lyrics.apply" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apply and lock"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用并锁定"}}}},
    "lyrics.enabled" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable lyrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用歌词"}}}},
    "lyrics.priority" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Source priority"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源优先级"}}}},
    "lyrics.priority.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tap Edit to reorder. Failed sources fall through to the next one. Manual matches remain locked."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点「编辑」调整顺序。某个来源加载失败时会尝试下一个。手动匹配的歌词仍会锁定。"}}}},
    "lyrics.cache" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cache"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缓存"}}}},
    "lyrics.cache.enabled" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cache lyrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缓存歌词"}}}},
    "lyrics.cache.days" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh after (days)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动刷新天数"}}}},
    "lyrics.cache.clear" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear lyric cache"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清除歌词缓存"}}}},
    "lyrics.matches.reset" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reset manual matches"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重置人工匹配"}}}},
    "lyrics.cache.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"0 means never expire. Expired lyrics appear immediately and refresh only in the foreground. Manual matches and timing offsets are stored separately."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"0 表示永不过期。过期歌词先展示，仅在应用前台异步刷新。人工匹配与延迟单独保存。"}}}},
    "lyrics.cache.clear.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletes cached raw and parsed lyrics. Keeps manual choices, timing offsets and credentials; the currently displayed lyrics remain until replaced."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除缓存里的歌词原文和解析结果。保留手动选择的歌词、延迟和凭据。当前显示的歌词会保留到被替换。"}}}},
    "lyrics.matches.reset.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Removes manual locks for all songs. Keeps lyric cache, timing offsets and credentials."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所有歌曲都会解除手动匹配锁定，恢复自动匹配。保留歌词缓存、延迟和凭据。"}}}},
    "lyrics.offset" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Timing offset for this song"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前歌曲歌词延迟"}}}},
    "lyrics.offset.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Positive values delay lyrics; negative values advance them. Range: ±10 seconds. This does not seek Spotify."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正值延后歌词，负值提前歌词，范围 ±10 秒。不会改变 Spotify 播放进度。"}}}},
    "lyrics.confirm" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm operation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认操作"}}}},
    "lyrics.delete" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除"}}}},
    "lyrics.save" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save configuration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存配置"}}}},
    "lyrics.saved" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存"}}}},
    "lyrics.apple.settings" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Music lyrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple Music 歌词"}}}},
    "lyrics.apple.region" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Region and translation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"地区与翻译"}}}},
    "lyrics.apple.storefront" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Storefront (us)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Storefront（默认 us）"}}}},
    "lyrics.apple.language" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation language (zh-Hans-CN)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译语言（默认 zh-Hans-CN）"}}}},
    "lyrics.apple.account" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Media user token"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账号凭据"}}}},
    "lyrics.apple.credentials.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a media-user-token from your own Apple Music web session. It may require an active subscription. Stored only in this device’s Keychain, not in lyric cache or diagnostics. This is not your password and is independent of Spotify login."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用你本人 Apple Music 网页会话的 media-user-token，可能需要有效订阅。仅保存在本机 Keychain，不进入歌词缓存或诊断。它不是账号密码，与 Spotify 登录无关。"}}}},
    "lyrics.apple.bearer" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Catalog bearer (advanced)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Catalog bearer（高级）"}}}},
    "lyrics.apple.bearer.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discovers AMPWebPlay tokens from Apple’s public web assets without executing scripts. A manual token takes priority. Expiry/format checks do not verify its signature. Unofficial endpoints may change or reject a region/account."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AMLL 会从 Apple 公开网页资源中查找 AMPWebPlay 令牌，过程不会运行网页脚本。手动填写的令牌优先。检查格式和到期时间无法确认签名。非公开接口可能变更，也可能受地区或账号限制。"}}}},
    "lyrics.apple.discover" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh automatic bearer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新自动 bearer"}}}},
    "lyrics.apple.discovered" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Bearer format and expiry checked (not signature verified)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已检查 bearer 格式和有效期（未验证签名）。"}}}},
    "lyrics.apple.clearAutomatic" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear automatic bearer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清除自动 bearer"}}}},
    "lyrics.apple.diagnostics" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection diagnostics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接诊断"}}}},
    "lyrics.apple.testCatalog" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Test public Catalog bearer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"验证公共 Catalog bearer"}}}},
    "lyrics.apple.testAccount" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Test account media-user-token"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"验证账号 media-user-token"}}}},
    "lyrics.apple.catalogOK" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Public Catalog check passed; lyric access has not been verified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"公共目录验证通过。是否能读取歌词还需另行确认。"}}}},
    "lyrics.apple.accountOK" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Account check passed; lyric access is checked per song and region."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账号验证通过。歌词权限仍需按歌曲和地区分别检查。"}}}},
    "lyrics.apple.expires" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cached automatic bearer expires:"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动 bearer 到期："}}}},
    "lyrics.apple.noAutomatic" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No valid automatic bearer cached; it will be discovered on demand."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前没有可用的自动 bearer 令牌。需要时会自动获取。"}}}},
    "lyrics.credential.saved" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credential saved in Keychain"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"凭据已保存到 Keychain"}}}},
    "lyrics.credential.empty" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not configured"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未配置"}}}},
    "lyrics.credential.saveMedia" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save media-user-token"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存 media-user-token"}}}},
    "lyrics.credential.deleteMedia" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete media-user-token"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除 media-user-token"}}}},
    "lyrics.credential.saveManual" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save manual bearer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存手动 bearer"}}}},
    "lyrics.credential.deleteManual" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete manual bearer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除手动 bearer"}}}},
    "lyrics.credential.deleteAll" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete all Apple lyric credentials"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除全部 Apple 歌词凭据"}}}},
    "lyrics.credential.delete.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletes the selected Keychain credential only. Spotify login, cached lyrics and manual matches are not deleted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只从 Keychain 删除所选凭据。Spotify 登录、歌词缓存和手动匹配都会保留。"}}}},
    "lyrics.error.notFound" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No synchronized lyrics found."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有找到同步歌词。"}}}},
    "lyrics.error.malformed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Invalid or unsupported lyric data."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"歌词数据损坏或格式不受支持。"}}}},
    "lyrics.error.tooLarge" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The lyric response exceeded safety limits."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"歌词响应超过安全限制。"}}}},
    "lyrics.error.transport" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Network request failed. Existing lyrics are retained."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网络请求失败，已有歌词会保留。"}}}},
    "lyrics.error.credentials" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Configure or renew your Apple Music media-user-token."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请配置或更新 Apple Music media-user-token。"}}}},
    "lyrics.error.bearer" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Public Catalog bearer unavailable, invalid or expired."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"公共 Catalog bearer 获取失败、无效或已过期。"}}}},
    "lyrics.error.account" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Apple Music account credential was rejected."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple Music 账号凭据验证失败。"}}}},
    "lyrics.error.permission" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Music lyric access denied; check storefront, subscription and lyric permissions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple Music 歌词访问被拒绝，请检查地区、订阅和歌词权限。"}}}},
    "lyrics.error.cache" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cache could not be read or saved. Current lyrics remain usable; changes may not survive a restart."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缓存读取或保存失败。当前歌词仍可使用，但修改可能无法在重启后保留。"}}}},
