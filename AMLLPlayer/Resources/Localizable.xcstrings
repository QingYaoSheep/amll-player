    "lyrics.apple.credentials.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a media-user-token from your own Apple Music web session. It may require an active subscription. Stored only in this device’s Keychain, not in lyric cache or diagnostics. This is not your password and is independent of Spotify login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你本人 Apple Music 网页会话的 media-user-token，可能需要有效订阅。仅保存在本机 Keychain，不进入歌词缓存或诊断。它不是账号密码，与 Spotify 登录无关。"
          }
        }
      }
    },
