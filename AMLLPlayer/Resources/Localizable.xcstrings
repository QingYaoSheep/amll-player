        }
      }
    },
    "lyrics.apple.bearer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catalog bearer (advanced)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Catalog bearer（高级）"
          }
        }
      }
    },
    "lyrics.apple.bearer.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discovers AMPWebPlay tokens from Apple’s public web assets without executing scripts. A manual token takes priority. Expiry/format checks do not verify its signature. Unofficial endpoints may change or reject a region/account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AMLL 会从 Apple 公开网页资源中查找 AMPWebPlay 令牌，过程不会运行网页脚本。手动填写的令牌优先。检查格式和到期时间无法确认签名。非公开接口可能变更，也可能受地区或账号限制。"
          }
        }
      }
    },
    "lyrics.apple.catalogOK": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public Catalog check passed; lyric access has not been verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公共目录验证通过。是否能读取歌词还需另行确认。"
          }
        }
      }
    },
    "lyrics.apple.clearAutomatic": {
