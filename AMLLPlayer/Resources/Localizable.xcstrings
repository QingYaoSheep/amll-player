    "about.privacyLocalBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account tokens are stored in your device Keychain. Cached lyrics, album artwork, and romanization data stay on device and are never uploaded or shared with third-party analytics."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号凭据仅保存在系统钥匙串（Keychain）中。歌词、专辑封面与音译缓存均保留在本地设备，不会上传或接入任何第三方统计追踪。"
          }
        }
      }
    },
