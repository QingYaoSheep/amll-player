    "render.background" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Static cover background"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"静态封面背景"}}}},
    "render.backgroundBlur" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Background blur"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"背景模糊"}}}},
    "render.backgroundHelp" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The album cover fills the screen without stretching. Blur stays at your chosen strength. Without artwork, a solid background is shown."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"专辑封面保持原比例，裁切后铺满屏幕。模糊程度按所选设置显示。没有封面时显示纯色。"}}}},
    "render.reset" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reset appearance"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复默认外观"}}}},
    "render.debug" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lyrics rendering preview"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"歌词渲染预览"}}}},
    "render.progress" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Playback position"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"播放进度"}}}},
