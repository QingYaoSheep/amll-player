    "settings.login.finishHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Copy the Client ID into the field above, then tap Authorize and sign in.\n4. In Development Mode, add the Spotify account you will use to the app's user access list if required. Playback controls may require Spotify Premium.\nNo Client Secret is needed: sign-in uses PKCE and the system browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 将 Client ID 复制到上方输入框，再点击“授权登录”。\n4. Development Mode 下，如有要求，请在应用的用户访问列表中添加要登录的 Spotify 账户。播放控制可能需要 Spotify Premium。\n登录使用 PKCE 和系统网页授权，无需填写 Client Secret。"
          }
        }
      }
    },
    "settings.login.saveHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Client ID is saved on this device when you tap Authorize. Changing it disconnects the current account and requires a new sign-in."
