    "player.noDevicesDescription" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Spotify on a phone, computer, speaker, or TV and refresh this list."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"先在要用的设备上打开 Spotify，再刷新列表。可以用手机或电脑，也可以用音箱或电视。"}}}},
