    "lyrics.enabled" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable lyrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用歌词"}}}},
    "lyrics.priority" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Source priority"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源优先级"}}}},
    "lyrics.priority.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tap Edit to reorder. Failed sources fall through to the next one. Manual matches remain locked."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点击编辑调整顺序。来源失败时继续尝试下一源；人工匹配保持锁定。"}}}},
    "lyrics.cache" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cache"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缓存"}}}},
    "lyrics.cache.enabled" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cache lyrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缓存歌词"}}}},
    "lyrics.cache.days" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh after (days)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动刷新天数"}}}},
    "lyrics.cache.clear" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear lyric cache"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清除歌词缓存"}}}},
    "lyrics.matches.reset" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reset manual matches"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重置人工匹配"}}}},
    "lyrics.cache.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"0 means never expire. Expired lyrics appear immediately and refresh only in the foreground. Manual matches and timing offsets are stored separately."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"0 表示永不过期。过期歌词先展示，仅在应用前台异步刷新。人工匹配与延迟单独保存。"}}}},
    "lyrics.cache.clear.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletes cached raw and parsed lyrics. Keeps manual choices, timing offsets and credentials; the currently displayed lyrics remain until replaced."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除缓存原文与解析结果。保留人工选择、延迟与凭据；当前显示的歌词会保留至被替换。"}}}},
    "lyrics.matches.reset.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Removes manual locks for all songs. Keeps lyric cache, timing offsets and credentials."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"解除所有歌曲的人工匹配锁定。保留歌词缓存、延迟与凭据。"}}}},
    "lyrics.offset" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Timing offset for this song"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前歌曲歌词延迟"}}}},
    "lyrics.offset.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Positive values delay lyrics; negative values advance them. Range: ±10 seconds. This does not seek Spotify."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正值延后歌词，负值提前歌词，范围 ±10 秒。不会改变 Spotify 播放进度。"}}}},
    "lyrics.confirm" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm operation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认操作"}}}},
    "lyrics.delete" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除"}}}},
    "lyrics.save" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save configuration"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存配置"}}}},
    "lyrics.saved" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存"}}}},
    "lyrics.apple.settings" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Music lyrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple Music 歌词"}}}},
    "lyrics.apple.region" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Region and translation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"地区与翻译"}}}},
    "lyrics.apple.storefront" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Storefront (us)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Storefront（默认 us）"}}}},
    "lyrics.apple.language" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation language (zh-Hans-CN)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译语言（默认 zh-Hans-CN）"}}}},
    "lyrics.apple.account" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Media user token"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账号凭据"}}}},
    "lyrics.apple.credentials.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a media-user-token from your own Apple Music web session. It may require an active subscription. Stored only in this device’s Keychain, not in lyric cache or diagnostics. This is not your password and is independent of Spotify login."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用你本人 Apple Music 网页会话的 media-user-token，可能需要有效订阅。仅保存在本机 Keychain，不进入歌词缓存或诊断。它不是账号密码，与 Spotify 登录无关。"}}}},
    "lyrics.apple.bearer" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Catalog bearer (advanced)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Catalog bearer（高级）"}}}},
    "lyrics.apple.bearer.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discovers AMPWebPlay tokens from Apple’s public web assets without executing scripts. A manual token takes priority. Expiry/format checks do not verify its signature. Unofficial endpoints may change or reject a region/account."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从 Apple 公开网页资源发现 AMPWebPlay 令牌，不执行脚本。手动令牌优先。格式/到期检查不代表签名认证；非公开接口可能变化，或限制地区与账号。"}}}},
    "lyrics.apple.discover" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh automatic bearer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新自动 bearer"}}}},
    "lyrics.apple.discovered" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Bearer format and expiry checked (not signature verified)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已检查 bearer 格式和有效期（未验证签名）。"}}}},
    "lyrics.apple.clearAutomatic" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear automatic bearer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清除自动 bearer"}}}},
    "lyrics.apple.diagnostics" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection diagnostics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接诊断"}}}},
    "lyrics.apple.testCatalog" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Test public Catalog bearer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"验证公共 Catalog bearer"}}}},
