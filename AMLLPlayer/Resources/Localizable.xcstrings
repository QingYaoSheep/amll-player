    "lyrics.evidence" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Matching and parsing details"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"匹配与解析详情"}}}},
    "lyrics.status.idle" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for a song"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等待歌曲"}}}},
    "lyrics.status.disabled" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lyrics disabled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"歌词已关闭"}}}},
    "lyrics.status.loading" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Finding lyrics…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在获取歌词…"}}}},
    "lyrics.status.ready" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lyrics ready"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"歌词已加载"}}}},
    "lyrics.status.cached" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Using cached lyrics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用缓存歌词"}}}},
    "lyrics.status.stale" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cached lyrics retained; refresh pending or failed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在显示已有歌词（等待刷新或刷新失败）"}}}},
    "lyrics.status.instrumental" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Marked as instrumental by the source"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源标记为纯音乐"}}}},
    "lyrics.status.notFound" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No synchronized lyrics found"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未找到同步歌词"}}}},
    "lyrics.status.failed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lyrics sources unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"歌词来源暂不可用"}}}},
