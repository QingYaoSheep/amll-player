    "lyrics.cache.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 means never expire. Expired lyrics appear immediately and refresh only in the foreground. Manual matches and timing offsets are stored separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0 表示永不过期。过期歌词先展示，仅在应用前台异步刷新。人工匹配与延迟单独保存。"
          }
        }
      }
    },
