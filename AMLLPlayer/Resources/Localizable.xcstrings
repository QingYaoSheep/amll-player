    "Apple Music 全库": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music Catalog"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music 全库"
          }
        }
      }
    },
    "Apple Music 拒绝访问，请检查系统授权、订阅和同步资料库状态。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music access was denied. Check system permissions, subscription, and Sync Library status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music 拒绝访问，请检查系统授权、订阅和同步资料库状态。"
          }
        }
      }
    },
    "Apple Music 服务不可用。请确认重签后的 Bundle ID 对应已启用 MusicKit 的 App ID，再重新检查。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music is unavailable. Make sure your re-signed Bundle ID maps to an App ID with MusicKit enabled, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music 服务不可用。请确认重签后的 Bundle ID 对应已启用 MusicKit 的 App ID，再重新检查。"
          }
        }
      }
    },
    "Apple Music 权限未允许，请在系统设置中允许音乐与媒体资料库访问。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music access is not allowed. Enable Media & Apple Music access in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music 权限未允许，请在系统设置中允许音乐与媒体资料库访问。"
          }
        }
      }
    },
    "Apple Music 电台": {
