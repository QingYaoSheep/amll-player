    "foundation.spotifyClientID" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spotify Client ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Spotify Client ID"}}}},
    "foundation.spotifyClientID.help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Settings → Login → Sign in to Spotify, enter your Client ID, and authorize in the browser."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开右上角设置 → 登录 → 登录到Spotify，填写 Client ID 后进行网页授权。"}}}},
