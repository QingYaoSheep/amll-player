<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="en">
  <head><metadata>
    <ttm:agent xml:id="v1" type="person"/><ttm:agent xml:id="v2" type="person"/><ttm:agent xml:id="v3" type="group"/>
    <itunes:translation xml:lang="zh-Hans-CN"><itunes:text for="L1">你好，世界！<span ttm:role="x-bg">（回声）</span></itunes:text></itunes:translation>
    <itunes:transliteration xml:lang="en"><itunes:text for="L1"><span begin="00:01.000" end="00:02.000">heh</span> <span begin="00:02.000" end="00:03.000">wo</span></itunes:text></itunes:transliteration>
  </metadata></head>
  <body><div>
    <p begin="00:01.000" end="00:04.000" ttm:agent="v1" itunes:key="L1"><span begin="00:01.000" end="00:02.000">Hello</span>, <span begin="00:02.000" end="00:03.000">world</span>!<span ttm:role="x-bg" begin="00:02.200" end="00:03.500"><span begin="00:02.200" end="00:03.500">(echo)</span></span></p>
    <p begin="00:05.000" end="00:07.000" ttm:agent="v2"><span begin="00:05.000" end="00:07.000">Reply</span></p>
    <p begin="00:08.000" end="00:10.000" ttm:agent="v3"><span begin="00:08.000" end="00:10.000">Together</span></p>
  </div></body>
</tt>
